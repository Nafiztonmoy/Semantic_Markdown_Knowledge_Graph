# ==========================================
# Dockerfile.worker - NexusDocs Background Worker
# ==========================================
FROM python:3.12-slim as builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml ./apps/api/
COPY apps/api/README.md ./apps/api/
RUN pip install --upgrade pip && \
    pip install ./apps/api

# Runner stage
FROM python:3.12-slim as runner

WORKDIR /app

RUN groupadd -g 1001 nexus && \
    useradd -u 1001 -g nexus -s /bin/bash -m nexus

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY apps/api /app/apps/api

USER nexus

ENV PYTHONPATH=/app

CMD ["python", "-m", "apps.api.app.services.worker"]
