# ==========================================
# NexusDocs Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Database (PostgreSQL + pgvector)
# For local Windows development without Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nexusdocs
# For Docker Compose:
# DATABASE_URL=postgresql+asyncpg://nexus:nexusdocs_secret@postgres:5432/nexusdocs

# Redis
# For local Windows development:
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Embedding Provider Configuration
# Supported providers: "local", "openai", "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM / RAG Provider Configuration
# Supported providers: "none", "openai", "gemini"
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=

# Knowledge Graph Thresholds
GRAPH_SIMILARITY_THRESHOLD=0.65
GRAPH_MAX_NEIGHBORS=5
